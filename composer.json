{
    "name": "jobmetric/laravel-reaction",
    "description": "This is a reaction management package for Laravel that you can use in your projects.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "jobmetric",
        "package",
        "reaction",
        "like",
        "dislike",
        "reaction management",
        "reaction system",
        "like system",
        "dislike system",
        "social interaction"
    ],
    "homepage": "https://doc.jobmetric.net/package/laravel-reaction",
    "authors": [
        {
            "name": "Majid Mohammadian",
            "email": "majeedmohammadian@gmail.com",
            "homepage": "https://www.linkedin.com/in/majidmohammadian/",
            "role": "Full Stack Developer"
        }
    ],
    "require": {
        "php": ">=8.0.1",
        "laravel/framework": ">=9.19",
        "jobmetric/laravel-package-core": "^1.20"
    },
    "autoload": {
        "psr-4": {
            "JobMetric\\Reaction\\": "src/",
            "JobMetric\\Reaction\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JobMetric\\Reaction\\ReactionServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "support": {
        "issues": "https://github.com/jobmetric/laravel-reaction/issues",
        "forum": "https://twitter.com/jobmetric",
        "source": "https://github.com/jobmetric/laravel-reaction"
    }
}
